{
    "name": "friendframe-backend",
    "version": "0.1.0",
    "private": true,
    "description": "API del panel de moderación de FriendFrame",
    "type": "module",
    "main": "dist/index.js",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "tsx watch --env-file=.env src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "express": "^5.3.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.2",
        "@types/supertest": "^7.2.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "supertest": "^7.3.2",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "vitest": "^5.1.1"
    }
}
