{
    "name": "frontend",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "start": "expo start",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "lint": "expo lint",
        "test": "jest",
        "test:unit": "jest --testPathPatterns=__tests__/unit",
        "test:unit:auth": "jest --testPathPatterns=__tests__/unit/auth",
        "test:unit:publications": "jest --testPathPatterns=__tests__/unit/publications",
        "test:unit:storage": "jest --testPathPatterns=__tests__/unit/storage",
        "test:components": "jest --testPathPatterns=__tests__/components",
        "test:integration": "jest --config jest.integration.config.js --runInBand",
        "test:integration:auth": "jest --config jest.integration.config.js --runInBand --testPathPatterns=__tests__/integration/auth",
        "test:integration:interactions": "jest --config jest.integration.config.js --runInBand --testPathPatterns=__tests__/integration/interactions",
        "test:integration:publications": "jest --config jest.integration.config.js --runInBand --testPathPatterns=__tests__/integration/publications",
        "test:integration:storage": "jest --config jest.integration.config.js --runInBand --testPathPatterns=__tests__/integration/storage",
        "test:ci": "jest --coverage --runInBand"
    },
    "dependencies": {
        "@expo-google-fonts/borel": "^0.4.2",
        "@expo-google-fonts/league-spartan": "^0.4.2",
        "@expo/vector-icons": "^15.0.3",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-google-signin/google-signin": "^16.1.2",
        "@react-native-masked-view/masked-view": "0.3.2",
        "@sentry/react-native": "^8.28.0",
        "@supabase/supabase-js": "^2.103.3",
        "@types/jest": "30.0.0",
        "babel-preset-expo": "~58.0.0",
        "dotenv": "^18.0.9",
        "expo": "^58.0.23",
        "expo-blur": "~58.0.5",
        "expo-constants": "~58.0.15",
        "expo-device": "~58.0.5",
        "expo-file-system": "~58.0.13",
        "expo-font": "~58.0.11",
        "expo-haptics": "~58.0.7",
        "expo-image": "~58.0.18",
        "expo-image-manipulator": "~58.0.16",
        "expo-image-picker": "~58.0.10",
        "expo-linear-gradient": "~58.0.3",
        "expo-linking": "~58.0.16",
        "expo-media-library": "~58.0.13",
        "expo-notifications": "~58.1.8",
        "expo-router": "~58.0.30",
        "expo-splash-screen": "~58.0.13",
        "expo-status-bar": "~58.0.4",
        "expo-symbols": "~58.0.4",
        "expo-system-ui": "~58.0.7",
        "expo-web-browser": "~58.0.7",
        "jest-expo": "~58.0.14",
        "nativewind": "^4.2.3",
        "node-gyp": "^12.4.0",
        "prettier-plugin-tailwindcss": "^0.5.14",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.1",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.11.1",
        "react-native-screens": "~4.30.1",
        "react-native-web": "^0.21.4",
        "react-native-worklets": "0.13.0",
        "rebuild": "^0.1.2",
        "tailwindcss": "^3.4.19"
    },
    "devDependencies": {
        "@testing-library/react-native": "^14.1.0",
        "@types/react": "~19.3.0",
        "eslint": "^9.25.0",
        "eslint-config-expo": "~58.0.4",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "prettier": "^3.9.9",
        "node-fetch": "^2.7.0",
        "react-test-renderer": "19.2.3",
        "supabase": "^2.105.0",
        "typescript": "~6.0.3"
    },
    "private": true,
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "@sentry/cli@3.8.2": true
    }
}
