{
    "name": "frontend",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "start": "expo start",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "lint": "expo lint",
        "test": "jest",
        "test:unit": "jest --testPathPattern=__tests__/unit",
        "test:unit:auth": "jest --testPathPattern=__tests__/unit/auth",
        "test:unit:publications": "jest --testPathPattern=__tests__/unit/publications",
        "test:unit:storage": "jest --testPathPattern=__tests__/unit/storage",
        "test:components": "jest --testPathPattern=__tests__/components",
        "test:integration": "jest --config jest.integration.config.js --runInBand",
        "test:integration:auth": "jest --config jest.integration.config.js --runInBand --testPathPattern=__tests__/integration/auth",
        "test:integration:interactions": "jest --config jest.integration.config.js --runInBand --testPathPattern=__tests__/integration/interactions",
        "test:integration:publications": "jest --config jest.integration.config.js --runInBand --testPathPattern=__tests__/integration/publications",
        "test:integration:storage": "jest --config jest.integration.config.js --runInBand --testPathPattern=__tests__/integration/storage",
        "test:ci": "jest --coverage --runInBand"
    },
    "dependencies": {
        "@expo-google-fonts/borel": "^0.4.2",
        "@expo-google-fonts/league-spartan": "^0.4.2",
        "@expo/vector-icons": "^15.0.3",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-google-signin/google-signin": "^16.1.2",
        "@react-native-masked-view/masked-view": "0.3.2",
        "@supabase/supabase-js": "^2.103.3",
        "@testing-library/react-native": "^13.3.3",
        "@types/jest": "29.5.14",
        "babel-preset-expo": "~57.0.0",
        "dotenv": "^18.0.4",
        "expo": "^57.0.0",
        "expo-blur": "~57.0.3",
        "expo-constants": "~57.0.19",
        "expo-device": "~57.0.2",
        "expo-file-system": "~57.0.7",
        "expo-font": "~57.0.4",
        "expo-haptics": "~57.0.3",
        "expo-image": "~57.0.5",
        "expo-image-manipulator": "~57.0.20",
        "expo-image-picker": "~57.0.20",
        "expo-linear-gradient": "~57.0.2",
        "expo-linking": "~57.0.11",
        "expo-media-library": "~57.0.5",
        "expo-notifications": "~57.0.21",
        "expo-router": "~57.0.23",
        "expo-splash-screen": "~57.0.9",
        "expo-status-bar": "~57.0.1",
        "expo-symbols": "~57.0.3",
        "expo-system-ui": "~57.0.4",
        "expo-web-browser": "~57.0.3",
        "jest": "~29.7.0",
        "jest-expo": "~57.0.5",
        "nativewind": "^4.2.3",
        "prettier-plugin-tailwindcss": "^0.5.14",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.10.1",
        "tailwindcss": "^3.4.19"
    },
    "devDependencies": {
        "@types/react": "~19.2.10",
        "eslint": "^9.25.0",
        "eslint-config-expo": "~57.0.2",
        "prettier": "^3.9.9",
        "node-fetch": "^2.7.0",
        "react-test-renderer": "19.2.3",
        "supabase": "^2.105.0",
        "typescript": "~6.0.3"
    },
    "private": true,
    "allowScripts": {}
}
